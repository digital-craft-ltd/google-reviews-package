# Google Places API key (server-side use only; lock to server IPs in Google Cloud)
GOOGLE_PLACES_API_KEY=

# Optional defaults to avoid passing props to every widget instance
# GOOGLE_PLACES_DEFAULT_PLACE_ID=
# GOOGLE_PLACES_DEFAULT_NAME=

# Cache lifetime in seconds (defaults to 86400 / 24h)
# GOOGLE_REVIEWS_CACHE_TTL=86400

# Secret token used by cron jobs to force a refresh
# GOOGLE_REVIEWS_CRON_SECRET=

# Vercel KV credentials
# Provided automatically in production once KV is attached to the project.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
