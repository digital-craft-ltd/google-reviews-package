{
  "name": "dc-google-reviews",
  "version": "0.3.0",
  "type": "module",
  "description": "Reusable Google Reviews widgets + API helpers for Astro projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-craft-ltd/google-reviews-package.git"
  },
  "bugs": {
    "url": "https://github.com/digital-craft-ltd/google-reviews-package/issues"
  },
  "homepage": "https://github.com/digital-craft-ltd/google-reviews-package#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components/*": "./dist/components/*",
    "./lib/client/googleReviewsClient": {
      "types": "./dist/lib/client/googleReviewsClient.d.ts",
      "import": "./dist/lib/client/googleReviewsClient.js",
      "require": "./dist/lib/client/googleReviewsClient.cjs"
    },
    "./lib/utils/reviewFormatting": {
      "types": "./dist/lib/utils/reviewFormatting.d.ts",
      "import": "./dist/lib/utils/reviewFormatting.js",
      "require": "./dist/lib/utils/reviewFormatting.cjs"
    },
    "./lib/server/googleReviews": {
      "types": "./dist/lib/server/googleReviews.d.ts",
      "import": "./dist/lib/server/googleReviews.js",
      "require": "./dist/lib/server/googleReviews.cjs"
    },
    "./server/googleReviewsHandler": {
      "types": "./dist/server/googleReviewsHandler.d.ts",
      "import": "./dist/server/googleReviewsHandler.js",
      "require": "./dist/server/googleReviewsHandler.cjs"
    },
    "./styles.css": "./dist/styles/google-reviews.css"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsc -p tsconfig.build.json",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:consumer": "node scripts/verify-astro-consumer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run verify:dist && npm test"
  },
  "keywords": [
    "astro",
    "google",
    "reviews",
    "widget",
    "google-maps",
    "places-api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "astro": "^5.15.1",
    "tsup": "^8.0.2",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4"
  },
  "allowScripts": {
    "esbuild": false,
    "sharp": false,
    "fsevents": false
  }
}
