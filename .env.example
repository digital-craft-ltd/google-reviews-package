# Required: Google Places API key (server-side use only)
GOOGLE_PLACES_API_KEY=

# Optional default place ID; otherwise pass placeId to each component
# GOOGLE_PLACES_DEFAULT_PLACE_ID=

# Optional cache lifetime in seconds (defaults to 86400 / 24h)
# GOOGLE_REVIEWS_CACHE_TTL=86400

# Optional shared secret required for forced refresh requests
# CRON_SECRET=

# Optional Redis credentials for persistent caching; all three are required.
# Without these, the package uses an in-memory cache local to the server process.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
#
# The following names are accepted as a fallback if the KV_REST_API_* names above
# are not set.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_REST_READ_ONLY_TOKEN=
