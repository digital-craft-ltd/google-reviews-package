---
import '../../styles/google-reviews.css';
import { createFallbackData, formatRatingDisplay, resolveReviewsUrl } from '../../lib/utils/reviewFormatting';

type Props = {
	placeId?: string;
	businessName?: string;
	languageCode?: string;
	reviewUrl?: string;
	class?: string;
	fallbackRating?: number;
	fallbackReviewCount?: number;
	heading?: string;
	subheading?: string;
	ctaText?: string;
	endpoint?: string;
};
const {
	placeId,
	businessName = '',
	languageCode = 'en',
	reviewUrl,
	class: className = '',
	fallbackRating,
	fallbackReviewCount,
	heading,
	subheading,
	ctaText,
	endpoint = '/api/google-reviews',
} = Astro.props as Props;

const resolvedPlaceId = placeId ?? import.meta.env.GOOGLE_PLACES_DEFAULT_PLACE_ID;

if (!resolvedPlaceId) {
	throw new Error('GoogleReviewsWidget requires a placeId prop or GOOGLE_PLACES_DEFAULT_PLACE_ID env var.');
}

const resolvedBusinessName = businessName || import.meta.env.GOOGLE_PLACES_DEFAULT_NAME || '';

const widgetId = `google-reviews-${Math.random().toString(36).slice(2, 10)}`;

const fallbackData = createFallbackData({ fallbackRating, fallbackReviewCount });
const initialRatingValue = fallbackData?.rating ?? null;
const initialRating = formatRatingDisplay(initialRatingValue);
const initialReviews =
	typeof fallbackReviewCount === 'number' && Number.isFinite(fallbackReviewCount)
		? fallbackReviewCount.toLocaleString()
		: null;
const ctaTemplate = ctaText ?? 'Read our {count} reviews';
const resolvedReviewUrl = resolveReviewsUrl(resolvedPlaceId, reviewUrl);

const widgetClientOptions = {
	id: widgetId,
};
const widgetOptionsJson = JSON.stringify(widgetClientOptions);

const hasInitialRating = typeof initialRatingValue === 'number';
const initialLabel = fallbackData ? (fallbackData.reviewCount === 1 ? 'review' : 'reviews') : 'reviews';
let initialCtaText = ctaTemplate;
if (initialCtaText.includes('{label}')) {
	initialCtaText = initialCtaText.replace('{label}', initialLabel);
}
if (initialReviews !== null) {
	initialCtaText = initialCtaText.replace('{count}', initialReviews);
} else if (initialCtaText.includes('{count}')) {
	// No fallback count available, surface a friendly placeholder.
	initialCtaText = initialCtaText.replace('{count}', 'No');
	// Strip trailing plural placeholder if still present.
	if (initialCtaText.includes('{label}')) {
		initialCtaText = initialCtaText.replace('{label}', 'reviews');
	}
	if (initialCtaText.trim().endsWith('No reviews')) {
		initialCtaText = 'No reviews yet';
	}
}
const initialScreenReaderCount = fallbackData
	? typeof fallbackData.reviewCount === 'number'
		? `${initialReviews} ${initialLabel}`
		: 'No reviews yet'
	: initialReviews ?? 'No reviews yet';
const initialUpdatedText = fallbackData ? 'Last updated just now' : 'Updating…';
const initialRatingAria = hasInitialRating
	? `Our Google Reviews rating is ${initialRating}`
	: 'Awaiting Google Reviews rating';
const initialStarsAria = hasInitialRating
	? `${initialRating} out of 5 stars`
	: 'Rating not available yet';
---

<section
	id={widgetId}
	class={`google-review-widget inline-flex flex-col items-center gap-3 rounded-md border border-white/60 bg-white px-5 py-4 text-center shadow-google-card ${className}`}
	data-place-id={resolvedPlaceId}
	data-language={languageCode}
	data-endpoint={endpoint}
	data-cta-template={ctaTemplate}
	data-business-name={resolvedBusinessName}
	data-review-url={resolvedReviewUrl ?? ''}
	data-google-reviews-options={widgetOptionsJson}
>
	{heading ? <p class="text-sm font-semibold uppercase tracking-wide text-neutral-600">{heading}</p> : null}
	<div class="flex flex-col items-center gap-3">
		<p class="text-5xl lg:text-6xl font-black leading-none text-neutral-900" data-rating aria-live="polite" aria-atomic="true" aria-label={initialRatingAria}>
			{initialRating}
		</p>
		<div class="flex items-center gap-2">
			<span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/80">
				<svg
					class="block h-full w-full"
					viewBox="0 0 31 32"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
					focusable="false"
				>
					<path
						fill="#4285f4"
						d="M16 13.091v6.196h8.611c-0.378 1.993-1.513 3.68-3.215 4.815l5.193 4.029c3.025-2.793 4.771-6.895 4.771-11.767 0-1.135-0.102-2.226-0.291-3.273z"
					/>
					<path
						fill="#34a853"
						d="M7.033 19.045l-1.171 0.896-4.146 3.229c2.633 5.222 8.029 8.829 14.283 8.829 4.32 0 7.942-1.425 10.589-3.869l-5.193-4.029c-1.425 0.96-3.244 1.542-5.396 1.542-4.16 0-7.694-2.807-8.96-6.589z"
					/>
					<path
						fill="#fbbc05"
						d="M1.716 8.829c-1.091 2.153-1.716 4.582-1.716 7.171s0.625 5.018 1.716 7.171c0 0.014 5.324-4.131 5.324-4.131-0.32-0.96-0.509-1.978-0.509-3.040s0.189-2.080 0.509-3.040z"
					/>
					<path
						fill="#ea4335"
						d="M16 6.371c2.356 0 4.451 0.815 6.124 2.385l4.582-4.582c-2.778-2.589-6.385-4.175-10.705-4.175-6.255 0-11.651 3.593-14.284 8.829l5.324 4.131c1.265-3.782 4.8-6.589 8.96-6.589z"
					/>
				</svg>
				<span class="sr-only">Google rating</span>
			</span>
			<div class="star-rating gap-[1px]" role="img" aria-live="polite" aria-atomic="true" aria-label={initialStarsAria}>
				{Array.from({ length: 5 }, (_, index) => (
					<span class="google-review-star" data-star={index} aria-hidden="true"></span>
				))}
			</div>
		</div>
		{subheading ? <p class="text-sm text-neutral-600">{subheading}</p> : null}
	</div>
	<div class="mt-4 flex flex-col items-center gap-2">
		<a
			href={resolvedReviewUrl ?? '#'}
			class="text-base font-medium text-google-blue hover:text-google-blue/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-google-blue"
			target="_blank"
			rel="noopener noreferrer"
			data-review-link
		>
			<span data-cta-text>{initialCtaText}</span>
			<span class="sr-only">
				(
				<span data-review-count>{initialScreenReaderCount}</span>
				total reviews
				)
			</span>
		</a>
		<!-- <p class="text-xs text-neutral-500" data-updated-at title="Last updated at">{initialUpdatedText}</p> -->
	</div>
	<template data-fallback>{fallbackData ? JSON.stringify(fallbackData) : ''}</template>
</section>
