# Google Places API key (server-side use only; lock to server IPs in Google Cloud)
GOOGLE_PLACES_API_KEY=

# Optional defaults to avoid passing props to every widget instance
# GOOGLE_PLACES_DEFAULT_PLACE_ID=

# Cache lifetime in seconds (defaults to 86400 / 24h)
# GOOGLE_REVIEWS_CACHE_TTL=86400

# Secret token used by cron jobs to force a refresh
# GOOGLE_REVIEWS_CRON_SECRET=

# Upstash Redis credentials (optional - falls back to an in-memory cache when unset)
# All three are required to enable the Redis-backed cache.
# Vercel projects with an Upstash integration attached provide these automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
#
# The Upstash-native variable names are accepted as a fallback if the KV_REST_API_*
# names above are not set. Use these when provisioning Upstash directly.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_REST_READ_ONLY_TOKEN=
