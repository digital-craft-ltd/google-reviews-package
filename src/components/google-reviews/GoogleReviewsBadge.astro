---
import '../../styles/google-reviews.css';
import { createFallbackData, formatRatingDisplay, resolveReviewsUrl } from '../../lib/utils/reviewFormatting';
import type { CommonProps } from './types';

type Props = CommonProps;

const {
	placeId,
	businessName = '',
	languageCode = 'en',
	reviewUrl,
	class: className = '',
	fallbackRating,
	fallbackReviewCount,
	ctaText,
	endpoint = '/api/google-reviews',
} = Astro.props as Props;

const resolvedPlaceId = placeId ?? import.meta.env.GOOGLE_PLACES_DEFAULT_PLACE_ID;

if (!resolvedPlaceId) {
	throw new Error('GoogleReviewsBadge requires a placeId prop or GOOGLE_PLACES_DEFAULT_PLACE_ID env var.');
}

const badgeId = `google-reviews-badge-${Math.random().toString(36).slice(2, 10)}`;
const initialBusinessName = businessName?.trim() ?? '';
const ctaTemplate = ctaText ?? '{count} {label}';

const badgeClientOptions = {
	id: badgeId,
	selectors: {
		starsContainer: '.badge-stars',
	},
	ctaTemplate,
	strings: {
		ratingAvailable: 'Google rating {rating} out of 5 stars',
		ratingPending: 'Google rating not available yet',
		starsAvailable: 'Google rating {rating} out of 5 stars',
		starsPending: 'Google rating not available yet',
		noReviewsText: 'No reviews yet',
		noReviewsCtaText: 'Leave a review',
	},
};

const fallbackData = createFallbackData({ fallbackRating, fallbackReviewCount });
const hasInitialRating = typeof fallbackData?.rating === 'number';
const initialRating = formatRatingDisplay(fallbackData?.rating ?? null);
const initialLabel = hasInitialRating
	? `Google rating ${initialRating} out of 5 stars`
	: 'Google rating not available yet';
const resolvedReviewUrl = resolveReviewsUrl(resolvedPlaceId, reviewUrl);
const initialReviewCountValue =
	typeof fallbackData?.reviewCount === 'number' && Number.isFinite(fallbackData.reviewCount)
		? fallbackData.reviewCount
		: null;
const initialReviewCountLabel = initialReviewCountValue === 1 ? 'review' : 'reviews';
let initialCtaText = ctaTemplate;

if (initialReviewCountValue !== null) {
	const formattedCount = initialReviewCountValue.toLocaleString();
	initialCtaText = initialCtaText
		.replace('{count}', formattedCount)
		.replace('{label}', initialReviewCountLabel);
} else {
	if (ctaText) {
		initialCtaText = ctaText && !ctaText.includes('{') ? ctaText : 'Leave a review';
	} else {
		initialCtaText = 'Leave a review';
	}
}
---

<section
	id={badgeId}
	class={`google-review-badge inline-flex flex-col gap-1 rounded-md border border-white/60 bg-white px-4 py-3 shadow-google-card ${className}`}
	data-place-id={resolvedPlaceId}
	data-language={languageCode}
	data-endpoint={endpoint}
	data-review-url={resolvedReviewUrl ?? ''}
	data-business-name={initialBusinessName}
	data-cta-template={ctaTemplate}
	data-google-reviews-options={JSON.stringify(badgeClientOptions)}
>
	<div class="flex items-center gap-2">
		<span class="badge-google-icon block h-5 w-5" aria-hidden="true">
			<svg
				class="block h-full w-full"
				viewBox="0 0 31 32"
				xmlns="http://www.w3.org/2000/svg"
				aria-hidden="true"
				focusable="false"
			>
				<path
					fill="#4285f4"
					d="M16 13.091v6.196h8.611c-0.378 1.993-1.513 3.68-3.215 4.815l5.193 4.029c3.025-2.793 4.771-6.895 4.771-11.767 0-1.135-0.102-2.226-0.291-3.273z"
				/>
				<path
					fill="#34a853"
					d="M7.033 19.045l-1.171 0.896-4.146 3.229c2.633 5.222 8.029 8.829 14.283 8.829 4.32 0 7.942-1.425 10.589-3.869l-5.193-4.029c-1.425 0.96-3.244 1.542-5.396 1.542-4.16 0-7.694-2.807-8.96-6.589z"
				/>
				<path
					fill="#fbbc05"
					d="M1.716 8.829c-1.091 2.153-1.716 4.582-1.716 7.171s0.625 5.018 1.716 7.171c0 0.014 5.324-4.131 5.324-4.131-0.32-0.96-0.509-1.978-0.509-3.040s0.189-2.080 0.509-3.040z"
				/>
				<path
					fill="#ea4335"
					d="M16 6.371c2.356 0 4.451 0.815 6.124 2.385l4.582-4.582c-2.778-2.589-6.385-4.175-10.705-4.175-6.255 0-11.651 3.593-14.284 8.829l5.324 4.131c1.265-3.782 4.8-6.589 8.96-6.589z"
				/>
			</svg>
		</span>
		<p
			class="badge-rating text-2xl font-bold leading-none text-neutral-900"
			data-rating
			aria-live="polite"
			aria-atomic="true"
			aria-label={initialLabel}
		>
			{initialRating}
		</p>
		<div class="badge-stars flex items-center gap-[2px]" role="img" aria-hidden={hasInitialRating ? 'false' : 'true'}>
			{Array.from({ length: 5 }, (_, index) => (
				<span class="badge-star" data-star={index} aria-hidden="true"></span>
			))}
		</div>
	</div>
	<a
		href={resolvedReviewUrl ?? '#'}
		class="badge-link text-xs font-medium text-blue-600 hover:text-blue-500 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
		target="_blank"
		rel="noopener noreferrer"
		data-review-link
	>
		<span data-cta-text>{initialCtaText}</span>
	</a>
	<template data-fallback>{fallbackData ? JSON.stringify(fallbackData) : ''}</template>
</section>
